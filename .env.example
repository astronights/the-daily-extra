# Postgres connection string. On Vercel, add a Neon database from the
# Storage tab and this is filled in for you. Leave empty locally to use
# a built-in database stored in ./.pglite
DATABASE_URL=

# Password for /admin, where you approve submissions and pack pitches.
ADMIN_PASSWORD=

# Any long random string. Used to sign the admin cookie and hash IPs.
SESSION_SECRET=
